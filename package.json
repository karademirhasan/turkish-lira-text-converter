{
  "name": "turkish-lira-text-converter",
  "description": "Convert Turkish lira amounts to uppercase Turkish text in Node.js and browsers",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.cjs",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    }
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "turkish-lira",
    "number-to-words",
    "currency-to-text",
    "amount-to-words",
    "try",
    "turkish",
    "lira",
    "browser",
    "node"
  ],
  "author": "Hasan Karademir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karademirhasan/turkish-lira-text-converter.git"
  },
  "bugs": {
    "url": "https://github.com/karademirhasan/turkish-lira-text-converter/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/karademirhasan"
  },
  "homepage": "https://github.com/karademirhasan/turkish-lira-text-converter#readme",
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test:browser": "node --test test/browser-entry.test.js",
    "build:cjs": "node scripts/build-cjs.js",
    "verify:package": "node scripts/verify-package.js",
    "prepack": "npm run build:cjs",
    "demo": "node demo/server.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
